# .env.example - safe template only. Do not put real secrets in this file.
# Copy to .env locally if your app loads dotenv, then fill real values only in your private .env.

# Anthropic / Claude
ANTHROPIC_API_KEY=<your_anthropic_api_key>
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Test A - local JSON + SQLite
BENEFITS_DATA_MODE=json_only
SHOW_LOCAL_STATE_DEBUG=true

# Test B - local Databricks trusted data + SQLite
# BENEFITS_DATA_MODE=databricks_first
# DATABRICKS_SERVER_HOSTNAME=<workspace-host-without-https>
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
# DATABRICKS_TOKEN=<your_local_databricks_pat>

# Test C - deployed Databricks App + Lakebase
# Prefer PG* variables when Databricks App/Lakebase resource injects them.
# Supply PGUSER/PGPASSWORD securely through Databricks secrets/app config.
# PGHOST=<injected-or-your-lakebase-host>
# PGPORT=5432
# PGDATABASE=<injected-or-your-database>
# PGSSLMODE=require
# PGUSER=<your_lakebase_user>
# PGPASSWORD=<your_lakebase_native_password>

# Compatibility aliases if using LAKEBASE_* locally.
# LAKEBASE_HOST=<your_lakebase_host>
# LAKEBASE_PORT=5432
# LAKEBASE_DATABASE=<your_database>
# LAKEBASE_SSLMODE=require
# LAKEBASE_USER=<your_lakebase_user>
# LAKEBASE_PASSWORD=<your_lakebase_native_password>
