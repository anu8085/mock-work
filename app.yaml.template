# app.yaml template - SAFE placeholders only.
# Copy to app.yaml in your NEW Databricks Free Edition workspace and fill values via
# resources/secrets. NEVER hardcode API keys, PATs, or Lakebase passwords here.

command: ["streamlit", "run", "app.py"]

env:
  - name: ANTHROPIC_API_KEY
    valueFrom: anthropic-api-key

  - name: CLAUDE_MODEL
    value: "claude-sonnet-4-5-20250929"

  - name: BENEFITS_DATA_MODE
    value: "databricks_first"

  - name: DATABRICKS_SERVER_HOSTNAME
    value: "<workspace-host-without-https>"

  - name: DATABRICKS_HTTP_PATH
    value: "/sql/1.0/warehouses/<warehouse-id>"

  - name: DATABRICKS_TOKEN
    valueFrom: databricks-token

  - name: SHOW_LOCAL_STATE_DEBUG
    value: "false"

  # V12 Lakebase decision: native Postgres password auth.
  # The Databricks App + Lakebase resource should inject PGHOST/PGPORT/PGDATABASE/
  # PGSSLMODE where available; supply only the user/password through secrets.
  - name: PGUSER
    valueFrom: lakebase-user
  - name: PGPASSWORD
    valueFrom: lakebase-password

  # Compatibility aliases if your deployment UI prefers LAKEBASE_*.
  - name: LAKEBASE_USER
    valueFrom: lakebase-user
  - name: LAKEBASE_PASSWORD
    valueFrom: lakebase-password

  # Lakebase resource binding (a resource reference, not a secret).
  - name: LAKEBASE_ENDPOINT
    valueFrom: lakebase-db

resources:
  - name: lakebase-db
    type: lakebase
  - name: anthropic-api-key
    type: secret
  - name: databricks-token
    type: secret
  - name: lakebase-user
    type: secret
  - name: lakebase-password
    type: secret
