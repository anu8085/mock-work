# Local-only example. Do not commit a real .env file.
ANTHROPIC_API_KEY=<your_anthropic_api_key>
CLAUDE_MODEL=claude-sonnet-4-5-20250929
BENEFITS_DATA_MODE=json_only
SHOW_LOCAL_STATE_DEBUG=true

# For local Test B only - use a short-lived local PAT if needed, never commit it.
DATABRICKS_SERVER_HOSTNAME=<workspace-host-without-https>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=<your_local_databricks_pat>

# Do not set Lakebase variables for Test A/Test B. Deployed Databricks App should use
# Lakebase app resource injected PG* env vars. Manual LAKEBASE_* variables are fallback only.
